{
  "name": "gods-flowers-school",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "r2_buckets": [
    {
      "binding": "APP_STORAGE"
    }
  ],
  "observability": {
    "enabled": true
  }
}
