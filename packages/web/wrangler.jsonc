{
  "name": "gods-flowers-main-5496",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "r2_buckets": [
    {
      "binding": "APP_STORAGE",
      "bucket_name": "gods-flowers-main-5496-app-storage"
    }
  ],
  "observability": {
    "enabled": true
  }
}
